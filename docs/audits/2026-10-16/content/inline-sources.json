    {
      "id": "fx-sign",
      "title": "원화 약세가 환노출 ETF의 환율 손실이라는 설명은 방향이 반대다",
      "queries": [
        {
          "id": "fx-structure",
          "source": {
            "label": "삼성자산운용 가이드·10/16 ETF 발행물",
            "metricDefinitions": [
              {
                "label": "검토 기준",
                "definition": "달러 자산 가격이 같을 때 USD/KRW 상승은 환노출 자산의 원화 환산 가치를 높인다."
              }
            ],
            "caveats": [
              "설명용 단순 환산이며 특정 ETF의 실제 수익률 계산이 아니다. 보수·헤지·추적오차·괴리는 제외했다."
            ],
            "links": [
              {
                "label": "환헤지·환노출 가이드",
                "url": "https://www.samsungfund.com/etf/insight/guide/view07.do"
              },
              {
                "label": "10/16 ETF 발행물",
                "url": "https://dailyreport-eta.vercel.app/etf-reports/2026-10-16.html"
              }
            ]
          },
          "methods": [
            {
              "language": "calculation",
              "code": "KRW return = (1 + USD asset return) × (1 + USD/KRW change) − 1\nUSD asset 0%, USD/KRW +1% → KRW +1%"
            }
          ]
        }
      ]
    },
    {
      "id": "event-timing",
      "title": "공식 발표일과 한국 거래 세션이 서술과 어긋난다",
      "queries": [
        {
          "id": "official-events",
          "source": {
            "label": "BLS 발표문·국가데이터처 10월 보도계획",
            "metricDefinitions": [
              {
                "label": "검토 기준",
                "definition": "CPI는 한국시간 10/14 21:30이며 9월 고용동향 계획은 10/16 08:00이다."
              }
            ],
            "caveats": [
              "고용 일정의 정확한 조회 URL은 감사 문서에 보존했다."
            ],
            "links": [
              {
                "label": "BLS 9월 CPI",
                "url": "https://www.bls.gov/news.release/archives/cpi_10142026.htm"
              },
              {
                "label": "10/14 ETF 발행물",
                "url": "https://dailyreport-eta.vercel.app/etf-reports/2026-10-14.html"
              },
              {
                "label": "10/15 Market 발행물",
                "url": "https://dailyreport-eta.vercel.app/reports/2026-10-15.html"
              }
            ]
          },
          "methods": [
            {
              "language": "calculation",
              "code": "2026-10-14 08:30 America/New_York = 2026-10-14 21:30 Asia/Seoul"
            }
          ]
        }
      ]
    },
    {
      "id": "period-binding",
      "title": "ETF의 하루 수익률이 주간 수익률로 서술됐다",
      "queries": [
        {
          "id": "weekly-check",
          "source": {
            "label": "KODEX 반도체 과거 종가·10/16 ETF 발행물",
            "metricDefinitions": [
              {
                "label": "검토 기준",
                "definition": "금요일 개장 전 WTD는 이번 주 이전 마지막 한국 거래일인 10/8 종가부터 10/15 종가까지다."
              }
            ],
            "caveats": [
              "10/9는 한국 휴장일이다. 10/16 당일 시세는 대조에서 제외했다."
            ],
            "links": [
              {
                "label": "10/16 ETF 발행물",
                "url": "https://dailyreport-eta.vercel.app/etf-reports/2026-10-16.html"
              },
              {
                "label": "KODEX 반도체 과거 종가",
                "url": "https://finance.yahoo.com/quote/091160.KS/history/"
              }
            ]
          },
          "rows": [
            {
              "구분": "발행물의 이번 주 서술",
              "수익률(%)": -11.94
            },
            {
              "구분": "10/15 하루 재계산",
              "수익률(%)": -11.9354
            },
            {
              "구분": "10/8→10/15 WTD 재계산",
              "수익률(%)": -23.1822
            }
          ],
          "columns": [
            "구분",
            "수익률(%)"
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "Daily: (112300 / 127520 − 1) × 100\nWTD: (112300 / 146190 − 1) × 100"
            }
          ]
        }
      ]
    },
