    {
      "id": "index-identity",
      "title": "ETF 보고서의 KOSPI 등락이 실제 지수와 다르다",
      "queries": [
        {
          "id": "index-comparison",
          "source": {
            "label": "발행 HTML·Market 스냅샷·Yahoo 과거 종가",
            "metricDefinitions": [
              {
                "label": "검토 기준",
                "definition": "같은 한국 거래일의 실제 KOSPI 수익률과 ETF 보고서의 KOSPI 서술을 비교했다."
              }
            ],
            "caveats": [
              "10/16 본문은 8% 넘게 하락했다고 서술했다.",
              "과거 종가는 검토 시 재조회했으며 원래 ETF 생성 입력 전체는 보존되지 않았다."
            ],
            "links": [
              {
                "label": "10/14 ETF 발행물",
                "url": "https://dailyreport-eta.vercel.app/etf-reports/2026-10-14.html"
              },
              {
                "label": "KOSPI 과거 종가",
                "url": "https://finance.yahoo.com/quote/%5EKS11/history/"
              }
            ]
          },
          "rows": [
